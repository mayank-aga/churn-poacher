# ==============================================================================
# The Churn Poacher - Environment Configuration
# ==============================================================================

# Core App Configuration
PROJECT_NAME="The Churn Poacher"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Demo Mode: Set to true to run end-to-end with realistic, clearly-labeled synthetic signals
# when external API credentials are not yet configured.
DEMO_MODE=true

# Database Configuration
# Default is local SQLite for immediate zero-config startup:
DATABASE_URL="sqlite+aiosqlite:///./churn_poacher.db"
# Or uncomment for PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/churn_poacher"

# Cache & Background Queue
REDIS_URL="redis://localhost:6379/0"

# AI / LLM Configuration
# Optional in DEMO_MODE, required for live synthesis
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Public API Integrations (Optional in DEMO_MODE)
# Reddit API (script app credentials from https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="ChurnPoacherBot/1.0.0"

# Hacker News API (Public Algolia endpoint, no key required)
HACKER_NEWS_API_BASE="https://hn.algolia.com/api/v1"

# Datadog Public Status Page API (Public, no key required)
DATADOG_STATUS_PAGE_URL="https://status.datadoghq.com/api/v2/summary.json"

# X / Twitter API v2 (Optional - only if developer credentials exist)
TWITTER_BEARER_TOKEN=""

# Enrichment & Stack Verification APIs (Optional)
CLEARBIT_API_KEY=""
APOLLO_API_KEY=""
GITHUB_TOKEN=""
