# =================================================================
# The Churn Poacher - Environment Configuration Reference
# Copy to .env and configure secrets prior to deployment
# =================================================================

# Environment & Server
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=generate-a-strong-random-64-character-secret-key-here
ENABLE_AUTH=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/churn_poacher
POSTGRES_DB=churn_poacher
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis & Background Worker Queue
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
WORKER_CONCURRENCY=4

# Multi-Provider LLM Credentials (at least one or fallback)
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Social & Monitoring Sources
HACKER_NEWS_API_BASE=https://hn.algolia.com/api/v1
DATADOG_STATUS_PAGE_URL=https://status.datadoghq.com/api/v2/summary.json
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ChurnPoacherBot/1.0.0
TWITTER_BEARER_TOKEN=

# Enrichment APIs
CLEARBIT_API_KEY=
APOLLO_API_KEY=
GITHUB_TOKEN=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
